-- ===== Tiện ích =====
local function GetChar()
	local c = lp.Character
	if not c then return end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	if hum and root then return c, hum, root end
end

local function IsPlayerCharacter(m)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character == m then return true end
	end
	return false
end

local function GetModelRoot(m)
	return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

-- Đã sửa: Đánh mọi model có máu, trừ mình, player khác, và đồng đội
local function IsEnemy(m)
	if not m or not m.Parent then return false end
	if m == lp.Character then return false end
	if IsPlayerCharacter(m) then return false end

	local hum = m:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end

	local myChar = lp.Character
	if myChar then
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		if myHum and myHum.Team and hum.Team and myHum.Team == hum.Team then
			return false
		end
	end
	return true
end

local function FindMyRaft()
	local b = Workspace:FindFirstChild("Bonfire", true)
	if b then return b end
	local cr = Workspace:FindFirstChild("Crafted")
	if cr then
		local f = cr:FindFirstChildWhichIsA("Model")
		if f then return f end
	end
	local pf = Workspace:FindFirstChild("Platforms")
	if pf then
		local f = pf:FindFirstChildWhichIsA("BasePart")
		if f then return f.Parent end
	end
end

-- ===== Fly =====
local FlyBody, FlyGyro
local function StartFly()
	local _, _, hrp = GetChar()
	if not hrp then return end
	FlyBody = Instance.new("BodyVelocity")
	FlyBody.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	FlyBody.Velocity = Vector3.zero
	FlyBody.Parent = hrp
	FlyGyro = Instance.new("BodyGyro")
	FlyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	FlyGyro.P = 9e4
	FlyGyro.Parent = hrp
	local _, hum = GetChar()
	if hum then hum.PlatformStand = true end
end

local function StopFly()
	if FlyBody then FlyBody:Destroy(); FlyBody = nil end
	if FlyGyro then FlyGyro:Destroy(); FlyGyro = nil end
	local _, hum = GetChar()
	if hum then hum.PlatformStand = false end
end

local function UpdateFly()
	local _, _, hrp = GetChar()
	if not hrp or not FlyBody or not FlyGyro then return end
	local dir = Vector3.zero
	if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
	if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
	if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
	if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
	if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
	if dir.Magnitude > 0 then dir = dir.Unit end
	FlyBody.Velocity = dir * State.FlySpeed
	FlyGyro.CFrame = Camera.CFrame
end

