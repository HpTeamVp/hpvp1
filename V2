local CurrentTab = "MAIN"
local Buttons = {}

local function ClearContent()
    for _, v in ipairs(Content:GetChildren()) do
        v:Destroy()
    end
end

local function AddToggle(name, callback)
    local B = MakeButton(
        Content,
        name .. " : OFF",
        UDim2.new(0, 0, 0, #Buttons * 43),
        UDim2.new(1, 0, 0, 36)
    )

    local state = false

    B.MouseButton1Click:Connect(function()
        state = not state
        B.Text = name .. (state and " : ON" or " : OFF")
        B.BackgroundColor3 = state and Purple
            or Color3.fromRGB(48, 34, 62)
        callback(state)
    end)

    table.insert(Buttons, B)
end

local function RenderTab(tab)
    CurrentTab = tab
    Buttons = {}
    ClearContent()

    if tab == "MAIN" then
        AddToggle("Tele Kill (chưa hỗ trợ)", function()
        end)

        AddToggle("Aim Súng (chưa hỗ trợ)", function()
        end)

        AddToggle("Hút vật phẩm (chưa hỗ trợ)", function()
        end)

        AddToggle("Né Attack (chưa hỗ trợ)", function()
        end)

    elseif tab == "ESP" then

        AddToggle("ESP Line", function(v)
            LineESP = v
        end)

        AddToggle("ESP Box", function(v)
            BoxESP = v
        end)

        AddToggle("ESP Health", function(v)
            HealthESP = v
        end)

        AddToggle("ESP Distance", function(v)
            DistanceESP = v
        end)

    elseif tab == "KHÁC" then

        AddToggle("Air Jump", function(v)
            AirJump = v
        end)

        AddToggle("Fly Air", function(v)
            Fly = v
        end)

        AddToggle("No Clip", function(v)
            Noclip = v
        end)

        AddToggle("Speed", function(v)
            Speed = v and 40 or 16
            if Humanoid then
                Humanoid.WalkSpeed = Speed
            end
        end)
    end
end

local function AddTab(name, pos)
    local B = MakeButton(
        Tabs,
        name,
        UDim2.new(pos, 0, 0, 0),
        UDim2.new(1/3, -4, 1, 0)
    )

    B.MouseButton1Click:Connect(function()
        RenderTab(name)
    end)
end

