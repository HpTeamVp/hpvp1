-- ESP SCANNER
--==================================================

task.spawn(function()
    while GUI.Parent do
        if State.ESPLine or State.ESPBox
            or State.ESPHealth or State.ESPDistance then

            for _,model in ipairs(Workspace:GetDescendants()) do
                if IsNPC(model) then
                    CreateESP(model)
                end
            end
        else
            for model in pairs(ESPObjects) do
                RemoveESP(model)
            end
        end

        task.wait(1)
    end
end)

