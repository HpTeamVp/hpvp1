    for k in pairs(S) do S[k] = false end
    local r, h = root(), hum()
    if origin and r then r.CFrame = origin end
    if h then h.WalkSpeed = 16 end
    stopFly()
    for p, v in pairs(ncOrig) do
        if p.Parent then p.CanCollide = v end
    end
    for m in pairs(espObjs) do destroyESP(m) end
    pcall(function() RunService:UnbindFromRenderStep("HpAim") end)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    gui:Destroy()
    env.HpTeamProUnload = nil
end
env.HpTeamProUnload = unload
btnClose.MouseButton1Click:Connect(unload)
