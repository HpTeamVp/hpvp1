local function addToggle(key, label)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 26)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.TextColor3 = Color3.new(1,1,1)
	b.BorderSizePixel = 0
	b.ZIndex = 12
	b.Parent = content
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	local function refresh()
		b.Text = label .. (State[key] and ": BẬT" or ": TẮT")
		b.BackgroundColor3 = State[key] and Color3.fromRGB(40, 140, 80) or Color3.fromRGB(60, 60, 68)
	end
	b.Activated:Connect(function()
		State[key] = not State[key]
		refresh()
		if key == "Fly" then
			if State.Fly then StartFly() else StopFly() end
		elseif key == "AntiAFK" then
			if State.AntiAFK then StartAntiAFK() else StopAntiAFK() end
		elseif key == "Fullbright" then
			if State.Fullbright then EnableFullbright() else DisableFullbright() end
		end
	end)
	refresh()
end

