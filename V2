local cache = {}

local function anyOn()
    for _, v in pairs(S) do
        if v then return true end
    end
    return false
end

local function refreshCache()
    local list = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("Humanoid") then
            local m = d.Parent
            if m and m:IsA("Model") and m ~= LP.Character and not Players:GetPlayerFromCharacter(m) then
                local r = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m.PrimaryPart
                if r then
                    table.insert(list, { model = m, hum = d, root = r })
                end
            end
        end
    end
    cache = list
end

task.spawn(function()
    while not unloaded do
        if anyOn() then pcall(refreshCache) end
        task.wait(1)
    end
end)

local function getTargets(origin, range)
    local out = {}
    for _, t in ipairs(cache) do
        if t.model.Parent and t.hum.Parent and t.root.Parent and t.hum.Health > 0 then
            local d = (t.root.Position - origin).Magnitude
            if d <= range then
                t.dist = d
                table.insert(out, t)
            end
        end
    end
    return out
end

local function nearest(origin, range)
    local best, bd = nil, math.huge
    for _, t in ipairs(getTargets(origin, range)) do
        if t.dist < bd then best, bd = t, t.dist end
    end
    return best
end

