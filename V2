-- Tìm quái gần nhất
local function getClosestTarget()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local closest = nil
    local minDist = scanRange
    
    for _, model in pairs(workspace:GetChildren()) do
        if model ~= char and model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
            local hum = model.Humanoid
            if hum.Health > 0 then
                if not Players:GetPlayerFromCharacter(model) then -- Bỏ dòng này nếu muốn đánh cả người
                    local dist = (model.HumanoidRootPart.Position - root.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = model
                    end
                end
            end
        end
    end
    return closest
end

-- HÀM TỰ ĐỘNG ĐÁNH (Kích hoạt Tool hoặc Click chuột)
local function autoAttack()
    -- 1. Nếu đang cầm Tool thì kích hoạt Tool
    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
    
    -- 2. Giả lập Click chuột trái (nếu game dùng click để đánh)
    local mouse = player:GetMouse()
    if mouse then
        -- Gửi tín hiệu click
        local click = Instance.new("ClickDetector") -- Dummy trick to trigger mouse event, or use VirtualInputManager if you have Synapse/Delta
        -- Vì Roblox chặn việc tự click trong game thường, nên cách tốt nhất là dùng Tool.
        -- Nếu bạn chạy Executor, có thể dùng `VirtualInputManager:SendMouseButtonEvent()`
    end
end

-- Vòng lặp chính (Dùng task.spawn để không treo Heartbeat)
task.spawn(function()
    while task.wait(0.1) do
        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        -- Nếu không bật gì thì trả về vị trí cũ (nếu đang kẹt)
        if isAttacking or (not killStates.Top and not killStates.Back and not killStates.Pro) then 
            if not isAttacking and savedCFrame then
                root.CFrame = savedCFrame
                savedCFrame = nil
            end
            continue 
        end

        local target = getClosestTarget()
        if target then
            isAttacking = true
            savedCFrame = root.CFrame
            
            local targetRoot = target.HumanoidRootPart
            local targetHum = target.Humanoid

            -- Thực hiện Tele và Đánh
            if killStates.Top then
                root.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.05)
                autoAttack() -- Gọi tự động đánh
                task.wait(0.05)
                root.CFrame = savedCFrame
                
            elseif killStates.Back then
                root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                task.wait(0.05)
                autoAttack()
                task.wait(0.05)
                root.CFrame = savedCFrame
                
            elseif killStates.Pro then
                root.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.02)
                -- Xoay 360 độ
                for i = 1, 6 do
                    root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(60), 0)
                    task.wait(0.02)
                end
                autoAttack()
                task.wait(0.05)
                root.CFrame = savedCFrame
            end
            
            isAttacking = false
            savedCFrame = nil
        end
    end
end)
