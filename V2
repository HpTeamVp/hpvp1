local origin, tkTarget = nil, nil

bind(RunService.Heartbeat, function()
    local r = root()
    if not r then return end

    if not S.TeleKill then
        if origin then r.CFrame = origin end
        origin, tkTarget = nil, nil
        return
    end

    if tkTarget and (not tkTarget.hum.Parent or tkTarget.hum.Health <= 0 or not tkTarget.root.Parent) then
        tkTarget = nil
    end

    if not tkTarget then
        local base = origin and origin.Position or r.Position
        tkTarget = nearest(base, RANGE)
        if tkTarget then
            origin = origin or r.CFrame
        else
            if origin then r.CFrame = origin end
            origin = nil
            return
        end
    end

    local tp = tkTarget.root.Position
    local pos = (tkTarget.root.CFrame * CFrame.new(0, 0, 3)).Position
    r.CFrame = CFrame.lookAt(pos, tp)
    r.AssemblyLinearVelocity = Vector3.zero
    for _ = 1, 3 do attack() end -- tăng tốc đánh
end)

