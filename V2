local function ClearESP() espFolder:ClearAllChildren() end

local function CreateHighlight(parent, color, label)
	local hl = Instance.new("Highlight")
	hl.FillColor = color
	hl.OutlineColor = Color3.new(1,1,1)
	hl.FillTransparency = 0.65
	hl.OutlineTransparency = 0.3
	hl.Adornee = parent
	hl.Parent = espFolder
	if label then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0,200,0,50)
		bb.StudsOffset = Vector3.new(0,3,0)
		bb.AlwaysOnTop = true
		bb.Adornee = parent:IsA("Model") and (parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")) or parent
		bb.Parent = espFolder
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1,0,1,0)
		tl.BackgroundTransparency = 1
		tl.TextColor3 = color
		tl.TextStrokeTransparency = 0.4
		tl.Text = label
		tl.Font = Enum.Font.GothamBold
		tl.TextSize = 14
		tl.Parent = bb
	end
end

local function UpdateESP()
	ClearESP()
	if State.PlayerESP then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and p.Character then
				CreateHighlight(p.Character, Color3.fromRGB(255,50,50), p.DisplayName)
			end
		end
	end
	if State.ItemESP then
		local cf = Workspace:FindFirstChild("Chests")
		if cf then
			for _, o in ipairs(cf:GetChildren()) do
				if o:IsA("Model") then CreateHighlight(o, Color3.fromRGB(255,215,0), o.Name) end
			end
		end
		for _, o in ipairs(Workspace:GetDescendants()) do
			if o:IsA("Model") and IsEnemy(o) then
				CreateHighlight(o, Color3.fromRGB(255,0,0), o.Name)
			end
		end
	end
end

task.spawn(function()
	while true do
		if State.PlayerESP or State.ItemESP then UpdateESP() end
		task.wait(3)
	end
end)

-- ===== Auto Farm / Chest / Eat =====
task.spawn(function()
	while true do
		task.wait(0.35)
		if not State.AutoFarm then continue end
		local _, _, hrp = GetChar()
		if not hrp then task.wait(1) continue end
		local closest, dist = nil, math.huge
		for _, o in ipairs(Workspace:GetDescendants()) do
			if not State.AutoFarm then break end
			if o:IsA("Humanoid") and o.Health > 0 then
				local m = o.Parent
				if m and IsEnemy(m) then
					local r = GetModelRoot(m)
					if r then
						local d = (r.Position - hrp.Position).Magnitude
						if d < dist then dist = d; closest = r end
					end
				end
			end
		end
		if closest and State.AutoFarm then
			if dist > 8 then
				hrp.CFrame = closest.CFrame + Vector3.new(0,2,0)
				task.wait(0.15)
			end
			local c = GetChar()
			if c then
				for _, t in ipairs(c:GetChildren()) do
					if t:IsA("Tool") then t:Activate() end
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.3)
		if not State.AutoChest then continue end
		local _, _, hrp = GetChar()
		if not hrp then task.wait(1) continue end
		local best, bd, bp = nil, math.huge, nil
		local cf = Workspace:FindFirstChild("Chests")
		local list = cf and cf:GetChildren() or {}
		for _, o in ipairs(Workspace:GetChildren()) do
			if o:IsA("Model") and CHEST_SET[o.Name] then table.insert(list, o) end
		end
		for _, o in ipairs(list) do
			if not State.AutoChest then break end
			if o:IsA("Model") and CHEST_SET[o.Name] then
				local pr
				for _, d in ipairs(o:GetDescendants()) do
					if d:IsA("ProximityPrompt") and d.Enabled then pr = d break end
				end
				if pr then
					local r = GetModelRoot(o) or o:FindFirstChildWhichIsA("BasePart")
					if r then
						local d = (r.Position - hrp.Position).Magnitude
						if d < bd then bd = d; best = r; bp = pr end
					end
				end
			end
		end
		if best and bp and State.AutoChest then
			hrp.CFrame = best.CFrame + Vector3.new(0,2,0)
			task.wait(0.3)
			if State.AutoChest and bp and bp.Parent then
				pcall(fireproximityprompt, bp)
			end
			task.wait(0.6)
		else
			task.wait(1.5)
		end
	end
end)

task.spawn(function()
	local fk = {"chowder","fish","meat","potato","fruit","food","pizza","coconut","banana","apple","steak","egg","berry"}
	while true do
		task.wait(2)
		if not State.AutoEat then continue end
		local _, hum = GetChar()
		if not hum or hum.Health >= hum.MaxHealth*0.7 then continue end
		local bp = lp:FindFirstChildOfClass("Backpack")
		if not bp then continue end
		for _, t in ipairs(bp:GetChildren()) do
			if not State.AutoEat then break end
			if t:IsA("Tool") then
				local n = t.Name:lower()
				local ok = false
				for _, kw in ipairs(fk) do
					if n:find(kw,1,true) then ok = true break end
				end
				if ok then
					hum:EquipTool(t)
					task.wait(0.1)
					t:Activate()
					task.wait(0.3)
					break
				end
			end
		end
	end
end)

local function StartAntiAFK()
	if antiIdleConn then return end
	local vu = game:GetService("VirtualUser")
	antiIdleConn = lp.Idled:Connect(function()
		vu:Button2Down(Vector2.zero, Camera.CFrame)
		task.wait(1)
		vu:Button2Up(Vector2.zero, Camera.CFrame)
	end)
end

local function StopAntiAFK()
	if antiIdleConn then antiIdleConn:Disconnect(); antiIdleConn = nil end
end

