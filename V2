local function MakeButton(parent, text, pos, size)
    local B = Instance.new("TextButton")
    B.Size = size
    B.Position = pos
    B.BackgroundColor3 = Color3.fromRGB(48, 34, 62)
    B.TextColor3 = White
    B.Text = text
