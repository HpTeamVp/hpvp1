local function isCharacterPart(p)
    local m = p:FindFirstAncestorOfClass("Model")
    return m and m:FindFirstChildOfClass("Humanoid") ~= nil
end

local function isPlayerPart(inst)
    local m = inst:FindFirstAncestorOfClass("Model")
    while m do
        if Players:GetPlayerFromCharacter(m) then return true end
        m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function matchAny(str, words)
    str = string.lower(str)
    for _, w in ipairs(words) do
        if str:find(w, 1, true) then return true end
    end
    return false
end

local function posOf(o)
    if o:IsA("BasePart") then return o.Position end
    if o:IsA("Attachment") then return o.WorldPosition end
    if o:IsA("Model") then
        local ok, cf = pcall(function() return o:GetPivot() end)
        if ok then return cf.Position end
    end
    return nil
end

local function holderPos(inst)
    local par = inst.Parent
    local depth = 0
    while par and depth < 6 do
        local p = posOf(par)
        if p then return p, par end
        par = par.Parent
        depth = depth + 1
    end
    return nil
end

-- Từ khóa nhận diện (thêm tên theo game của bạn vào đây)
local fireWords = { "campfire", "camp fire", "bonfire", "fireplace", "fire pit", "firepit", "campsite", "lửa trại", "lò lửa", "đống lửa", "lửa" }
local craftWords = { "craft", "workbench", "work bench", "anvil", "forge", "chế tạo", "bàn chế", "lò rèn", "crafting", "bàn craft" }
local fuelWords = { "wood", "log", "stick", "branch", "coal", "fuel", "plank", "gỗ", "củi", "than", "cành" }
local matWords = {
    "wood", "log", "stick", "branch", "coal", "plank", "stone", "rock", "iron", "ore", "scrap",
    "metal", "gold", "cloth", "fiber", "rope", "leather", "gỗ", "củi", "đá", "sắt", "vàng", "than",
}

local FARM_RANGE = 500
local AT_STATION = 12 -- vật phẩm cách trạm dưới mức này coi như đã tới nơi
local farmOrigin = nil
local visited = {}
local stations = { fire = {}, craft = {} }
local items = { fuel = {}, mat = {} }

local function textOf(inst, holder)
    local t = ""
    if inst:IsA("ProximityPrompt") then t = inst.ActionText .. " " .. inst.ObjectText .. " " end
    local h = holder
    for _ = 1, 3 do
        if h and h ~= Workspace then
            t = t .. h.Name .. " "
            h = h.Parent
        end
    end
    return t
end

-- Chọn đối tượng thật sự cần dời: cả model nhỏ chứa vật phẩm, hoặc chính part đó
local function resolveTarget(holder)
    while holder and not (holder:IsA("BasePart") or holder:IsA("Model")) do
        holder = holder.Parent
    end
    if not holder then return nil end
    if holder:IsA("BasePart") then
        local m = holder:FindFirstAncestorOfClass("Model")
        if m and m ~= Workspace and not m:FindFirstChildOfClass("Humanoid") then
            local ok, size = pcall(function() return m:GetExtentsSize().Magnitude end)
            if ok and size <= 30 and #m:GetDescendants() <= 40 then return m end
        end
    end
    return holder
end

local function addItem(obj, holder, txt)
    local target = resolveTarget(holder)
    if not target then return end
    local c = { obj = obj, target = target }
    if matchAny(txt, fuelWords) then table.insert(items.fuel, c) end
    if matchAny(txt, matWords) then table.insert(items.mat, c) end
end

local function scanFarm()
    local fire, craft = {}, {}
    items = { fuel = {}, mat = {} }
    for _, d in ipairs(Workspace:GetDescendants()) do
        if not (LP.Character and d:IsDescendantOf(LP.Character)) then
            if (d:IsA("ProximityPrompt") and d.Enabled) or d:IsA("ClickDetector") then
                local _, holder = holderPos(d)
                if holder and not isPlayerPart(holder) then
                    local txt = textOf(d, holder)
                    if matchAny(txt, fireWords) then
                        table.insert(fire, { obj = holder, target = resolveTarget(holder) })
                    elseif matchAny(txt, craftWords) then
                        table.insert(craft, { obj = holder, target = resolveTarget(holder) })
                    else
                        addItem(d, holder, txt)
                    end
                end
            elseif (d:IsA("Model") or d:IsA("BasePart")) and not isCharacterPart(d) and not isPlayerPart(d) then
                local name = d.Name
                if matchAny(name, fireWords) then
                    table.insert(fire, { obj = d, target = d })
                elseif matchAny(name, craftWords) then
                    table.insert(craft, { obj = d, target = d })
                elseif d:IsA("BasePart") and not d.Anchored and d.Size.Magnitude <= 12 then
                    addItem(d, d, name .. " " .. (d.Parent and d.Parent.Name or ""))
                end
            end
        end
    end
    stations.fire, stations.craft = fire, craft
end

task.spawn(function()
    while not unloaded do
        if S.FarmCraft or S.FarmFire then pcall(scanFarm) end
        task.wait(1.5)
    end
end)

local function itemPos(c)
    return posOf(c.target or c.obj)
end

local function goTo(r, pos, y)
    r.CFrame = CFrame.new(pos + Vector3.new(0, y or 2.5, 0))
    r.AssemblyLinearVelocity = Vector3.zero
end

-- Dời vật phẩm tới chỗ đống lửa / bàn craft
local function moveItem(c, cf)
    local target = c.target
    if not target or not target.Parent then return end
    pcall(function()
        if target:IsA("Model") then
            target:PivotTo(cf)
            for _, p in ipairs(target:GetDescendants()) do
                if p:IsA("BasePart") then p.AssemblyLinearVelocity = Vector3.zero end
            end
        else
            target.AssemblyLinearVelocity = Vector3.zero
            target.CFrame = cf
        end
    end)
end

local function nearestOf(list, from, useVisited, avoidPos)
    local best, bd = nil, math.huge
    local base = farmOrigin and farmOrigin.Position or from
    for _, c in ipairs(list) do
        local t = c.target or c.obj
        if t and t.Parent and not (useVisited and visited[t] and os.clock() - visited[t] < 120) then
            local p = itemPos(c)
            if p and (p - base).Magnitude <= FARM_RANGE
                and not (avoidPos and (p - avoidPos).Magnitude < AT_STATION) then
                local d = (p - from).Magnitude
                if d < bd then best, bd = c, d end
            end
        end
    end
    return best
end

local lastNote = 0
local function notify(msg)
    if os.clock() - lastNote < 8 then return end
    lastNote = os.clock()
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Hp Team Pro V1", Text = msg, Duration = 4 })
    end)
end

-- Mỗi lần: tele tới vật phẩm -> tele vật phẩm cùng người về trạm
local function bring(list, st, r)
    local dest = itemPos(st)
    if not dest then return false end
    local it = nearestOf(list, r.Position, true, dest)
    if not it then return false end
    visited[it.target or it.obj] = os.clock()

    -- 1. tele đến vật phẩm (để có quyền vật lý)
    local p = itemPos(it)
    if not p then return false end
    goTo(r, p, 2.5)
    task.wait(0.2)

    -- 2. tele về trạm và giữ vật phẩm ở đó (đặt lại liên tục để server nhận vị trí)
    goTo(r, dest, 3)
    local cf = CFrame.new(dest + Vector3.new(math.random(-2, 2), 3, math.random(-2, 2)))
    for _ = 1, 6 do
        moveItem(it, cf)
        task.wait(0.1)
    end
    return true
end


local function farmFire(r)
    local st = nearestOf(stations.fire, r.Position, false)
    if not st then
        notify("Farm Campfire: không tìm thấy đống lửa")
        return false
    end
    local ok = bring(items.fuel, st, r)
    if not ok then notify("Farm Campfire: hết củi / gỗ để dời") end
    return ok
end

local function farmCraft(r)
    local st = nearestOf(stations.craft, r.Position, false)
    if not st then
        notify("Farm Craft: không tìm thấy bàn craft")
        return false
    end
    local ok = bring(items.mat, st, r)
    if not ok then notify("Farm Craft: hết nguyên liệu để dời") end
    return ok
end

task.spawn(function()
    while not unloaded do
        task.wait(0.2)
        local r = root()
        if r and (S.FarmCraft or S.FarmFire) then
            farmOrigin = farmOrigin or r.CFrame
            local did = false
            if S.FarmFire then did = farmFire(r) or did end
            if S.FarmCraft then did = farmCraft(r) or did end
            if not did then
                r.CFrame = farmOrigin -- hết vật phẩm: về điểm gốc
                task.wait(0.5)
            end
        elseif farmOrigin and r then
            r.CFrame = farmOrigin
            farmOrigin = nil
        end
    end
end)

