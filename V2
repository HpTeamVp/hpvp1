local function makeESP(t)
    local o = {}

    o.box = Instance.new("SelectionBox")
    o.box.LineThickness = 0.03
    o.box.Color3 = Color3.fromRGB(255, 70, 70)
    o.box.Parent = espFolder

    local bb = Instance.new("BillboardGui")
    bb.Adornee = t.root
    bb.AlwaysOnTop = true
    bb.Size = UDim2.fromOffset(90, 28)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.Parent = espFolder
    o.bb = bb

    o.hpBg = Instance.new("Frame")
    o.hpBg.Size = UDim2.new(1, 0, 0, 6)
    o.hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    o.hpBg.BorderSizePixel = 0
    o.hpBg.Parent = bb

    o.hpFill = Instance.new("Frame")
    o.hpFill.Size = UDim2.new(1, 0, 1, 0)
    o.hpFill.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
    o.hpFill.BorderSizePixel = 0
    o.hpFill.Parent = o.hpBg

    o.dist = Instance.new("TextLabel")
    o.dist.Position = UDim2.new(0, 0, 0, 8)
    o.dist.Size = UDim2.new(1, 0, 0, 18)
    o.dist.BackgroundTransparency = 1
    o.dist.TextColor3 = Color3.new(1, 1, 1)
    o.dist.TextStrokeTransparency = 0.4
    o.dist.Font = Enum.Font.GothamBold
    o.dist.TextSize = 13
    o.dist.Parent = bb

    o.line = Instance.new("Frame")
    o.line.AnchorPoint = Vector2.new(0.5, 0.5)
    o.line.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    o.line.BorderSizePixel = 0
    o.line.Visible = false
    o.line.ZIndex = 5
    o.line.Parent = lineGui

    espObjs[t.model] = o
    return o
end

local function destroyESP(m)
    local o = espObjs[m]
    if not o then return end
    pcall(function() o.box:Destroy() end)
    pcall(function() o.bb:Destroy() end)
    if o.line then pcall(function() o.line:Destroy() end) end
    espObjs[m] = nil
end

bind(RunService.RenderStepped, function()
    local r = root()
    local wanted = {}
    if r and (S.EspLine or S.EspBox or S.EspHp or S.EspDist) then
        for _, t in ipairs(getTargets(r.Position, RANGE)) do
            wanted[t.model] = t
        end
    end

    for m in pairs(espObjs) do
        if not wanted[m] then destroyESP(m) end
    end

    for m, t in pairs(wanted) do
        local o = espObjs[m] or makeESP(t)
        o.box.Adornee = S.EspBox and m or nil
        o.bb.Enabled = S.EspHp or S.EspDist
        o.hpBg.Visible = S.EspHp
        o.dist.Visible = S.EspDist

        if S.EspHp then
            local mh = math.max(t.hum.MaxHealth, 1)
            local f = math.clamp(t.hum.Health / mh, 0, 1)
            o.hpFill.Size = UDim2.new(f, 0, 1, 0)
            o.hpFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - f), 220 * f, 60)
        end
        if S.EspDist then
            o.dist.Text = math.floor(t.dist) .. "m"
        end

        if S.EspLine then
            local v, on = Camera:WorldToViewportPoint(t.root.Position)
            if on then
                local from = Vector2.new(Camera.ViewportSize.X / 2, 0)
                local to = Vector2.new(v.X, v.Y)
                local d = to - from
                o.line.Size = UDim2.fromOffset(d.Magnitude, 2)
                o.line.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
                o.line.Rotation = math.deg(math.atan2(d.Y, d.X))
                o.line.Visible = true
            else
                o.line.Visible = false
            end
        else
            o.line.Visible = false
        end
    end
end)

