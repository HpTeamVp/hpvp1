local function StartFly()
    if not Root or not Humanoid then return end

    StopFly()

    FlyPosition = Instance.new("BodyPosition")
    FlyPosition.MaxForce = Vector3.new(1e6,1e6,1e6)
    FlyPosition.P = 30000
    FlyPosition.D = 1500
    FlyPosition.Position = Root.Position
    FlyPosition.Parent = Root

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.MaxTorque = Vector3.new(1e6,1e6,1e6)
    FlyGyro.P = 30000
    FlyGyro.CFrame = Root.CFrame
    FlyGyro.Parent = Root
end

--==================================================
-- SPEED / NOCLIP / FLY UPDATE
--==================================================

local OriginalCollision = {}

RunService.Heartbeat:Connect(function()
    if not Character or not Humanoid or not Root then
        return
    end

    Humanoid.WalkSpeed = State.Speed and SpeedValue or 16

    if State.Noclip then
        for _,part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                if OriginalCollision[part] == nil then
                    OriginalCollision[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    else
        for part,value in pairs(OriginalCollision) do
            if part and part.Parent then
                part.CanCollide = value
            end
        end
        table.clear(OriginalCollision)
    end

    if State.Fly then
        if not FlyPosition then
            StartFly()
        end

        if FlyPosition and FlyGyro then
            FlyPosition.Position = Root.Position
            FlyGyro.CFrame = Camera.CFrame
        end
    elseif FlyPosition then
        StopFly()
    end
end)

--==================================================
-- TAB SYSTEM
--==================================================

local function ClearTab()
    for _,obj in ipairs(Content:GetChildren()) do
        if obj:IsA("GuiObject") then
            obj:Destroy()
        end
    end
end

local function AddToggle(name,key,callback)
    local button = Button(
        Content,
        name .. " : " ..
        (State[key] and "ON" or "OFF"),
        UDim2.new(),
        UDim2.new(1,-5,0,40)
    )

    button.LayoutOrder = #Content:GetChildren()

    button.MouseButton1Click:Connect(function()
        State[key] = not State[key]

        button.Text = name .. " : " ..
            (State[key] and "ON" or "OFF")

        button.BackgroundColor3 = State[key]
            and PURPLE or PANEL

        if callback then
            callback(State[key])
        end
    end)
end

local function AddSlider()
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1,-5,0,40)
    box.BackgroundColor3 = PANEL
    box.TextColor3 = WHITE
    box.PlaceholderText = "Speed: 32"
    box.Text = tostring(SpeedValue)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.Parent = Content

    Instance.new("UICorner",box).CornerRadius =
        UDim.new(0,8)

    box.FocusLost:Connect(function()
        local value = tonumber(box.Text)

        if value then
            SpeedValue = math.clamp(value,16,100)
            box.Text = tostring(SpeedValue)
        else
            box.Text = tostring(SpeedValue)
        end
    end)
end

local function RenderTab(tab)
    ClearTab()

    if tab == "MAIN" then
        AddToggle("Tele Kill - API", "TeleKill")
        AddToggle("Aim Súng - API", "Aim")
        AddToggle("Hút Vật Phẩm - API", "ItemMagnet")
        AddToggle("Né Attack - API", "Dodge")

    elseif tab == "ESP" then
        AddToggle("ESP Line","ESPLine")
        AddToggle("ESP Box","ESPBox")
        AddToggle("ESP Health","ESPHealth")
        AddToggle("ESP Distance","ESPDistance")

    elseif tab == "KHÁC" then
        AddToggle("Air Jump","AirJump")
        AddToggle("Fly Air","Fly",function(enabled)
            if not enabled then
                StopFly()
            end
        end)
        AddToggle("No Clip","Noclip")
        AddToggle("Speed","Speed")
        AddSlider()
    end
end

local function MakeTab(name,index)
    local tab = Button(
        TabBar,
        name,
        UDim2.new(index/3,3,0,0),
        UDim2.new(1/3,-6,1,0)
    )

    tab.MouseButton1Click:Connect(function()
        RenderTab(name)
    end)
end

MakeTab("MAIN",0)
MakeTab("ESP",1)
MakeTab("KHÁC",2)

RenderTab("MAIN")

