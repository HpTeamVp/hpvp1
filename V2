-- ===== KÉO THẢ =====
local dragging = false
local dragStart, startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ===== THU NHỎ / PHÓNG TO / THOÁT =====
local minimized = false
local normalSize = UDim2.new(0, 260, 0, 340)

minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        content.Visible = false
        footer.Visible = false
        main:TweenSize(UDim2.new(0, 260, 0, 36),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    else
        main:TweenSize(normalSize,
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        task.wait(0.2)
        content.Visible = true
        footer.Visible = true
    end
end)

local maximized = false
maxBtn.MouseButton1Click:Connect(function()
    maximized = not maximized
    local target = maximized and UDim2.new(0, 360, 0, 480) or normalSize
    main:TweenSize(target,
        Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
end)

closeBtn.MouseButton1Click:Connect(function()
    gui:Destroy()
end)
