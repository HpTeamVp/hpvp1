-- 4. NÉ ATTACK
----------------------------------------------------------------
local atkWords = { "attack", "slash", "hit", "punch", "swing", "skill", "combo", "strike", "cast", "shoot", "m1", "smash" }
local dodgeTarget, dodgeUntil, dodgeAngle = nil, 0, 0

local function isAttacking(t)
    local ok, res = pcall(function()
        local src = t.hum:FindFirstChildOfClass("Animator") or t.hum
        for _, tr in ipairs(src:GetPlayingAnimationTracks()) do
            local n = string.lower(tr.Name)
            for _, w in ipairs(atkWords) do
                if n:find(w, 1, true) then return true end
            end
        end
        return false
    end)
    return ok and res
end

bind(RunService.Heartbeat, function()
    if not S.Dodge or tkTarget then return end
    local r = root()
    if not r then return end

    if os.clock() < dodgeUntil and dodgeTarget and dodgeTarget.root.Parent then
        dodgeAngle = dodgeAngle + 0.18
        local c = dodgeTarget.root.Position
        local pos = Vector3.new(c.X + math.cos(dodgeAngle) * 14, r.Position.Y, c.Z + math.sin(dodgeAngle) * 14)
        r.CFrame = CFrame.lookAt(pos, Vector3.new(c.X, pos.Y, c.Z))
        r.AssemblyLinearVelocity = Vector3.zero
    else
        for _, t in ipairs(getTargets(r.Position, 30)) do
            if isAttacking(t) then
                local c = t.root.Position
                dodgeTarget = t
                dodgeUntil = os.clock() + 0.7
                dodgeAngle = math.atan2(r.Position.Z - c.Z, r.Position.X - c.X) + 1.2
                break
            end
        end
    end
end)
