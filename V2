local lastJumpReq = 0
bind(UIS.JumpRequest, function() lastJumpReq = os.clock() end)

local function jumpHeld()
    local h = hum()
    return UIS:IsKeyDown(Enum.KeyCode.Space) or (h and h.Jump) or (os.clock() - lastJumpReq < 0.15)
end

-- Nhảy trên không
bind(RunService.Heartbeat, function()
    if not S.AirJump or S.Fly then return end
    local r = root()
    if r and jumpHeld() then
        local v = r.AssemblyLinearVelocity
        r.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z)
    end
end)

-- Fly Air
local bv = nil
local function stopFly()
    if bv then bv:Destroy() bv = nil end
end

bind(RunService.Heartbeat, function()
    local r, h = root(), hum()
    if not (S.Fly and r and h) then
        stopFly()
        return
    end
    if not bv or bv.Parent ~= r then
        stopFly()
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = r
    end
    local spd = S.Speed and speedVal or h.WalkSpeed
    local dir = h.MoveDirection * spd
    bv.Velocity = Vector3.new(dir.X, jumpHeld() and 50 or 0, dir.Z)
end)

-- No Clip
local ncOrig = {}
bind(RunService.Stepped, function()
    local c = LP.Character
    if S.NoClip and c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                if ncOrig[p] == nil then ncOrig[p] = p.CanCollide end
                p.CanCollide = false
            end
        end
    elseif next(ncOrig) then
        for p, v in pairs(ncOrig) do
            if p.Parent then p.CanCollide = v end
        end
        ncOrig = {}
    end
end)

-- Speed
local speedWasOn = false
bind(RunService.Heartbeat, function()
    local h = hum()
    if not h then return end
    if S.Speed then
        h.WalkSpeed = speedVal
        speedWasOn = true
    elseif speedWasOn then
        h.WalkSpeed = 16
        speedWasOn = false
    end
end)

