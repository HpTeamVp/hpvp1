local function isCharacterPart(p)
    local m = p:FindFirstAncestorOfClass("Model")
    return m and m:FindFirstChildOfClass("Humanoid") ~= nil
end

task.spawn(function()
    while not unloaded do
        task.wait(0.8)
        if S.Pull then
            local r = root()
            if r then
                for _, d in ipairs(Workspace:GetDescendants()) do
                    if d:IsA("BasePart") and not d:IsDescendantOf(LP.Character) then
                        local isHandle = d.Name == "Handle" and d.Parent and d.Parent:IsA("Tool")
                        local hasTouch = d:FindFirstChildOfClass("TouchTransmitter") ~= nil
                        if (isHandle or hasTouch) and not isCharacterPart(d)
                            and (d.Position - r.Position).Magnitude <= RANGE then
                            if firetouchinterest then
                                pcall(function()
                                    firetouchinterest(r, d, 0)
                                    firetouchinterest(r, d, 1)
                                end)
                            end
                            if not d.Anchored then
                                pcall(function() d.CFrame = r.CFrame end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

