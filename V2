--==================================================
-- NPC ESP
--==================================================

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "HP_ESP_OBJECTS"
ESPFolder.Parent = GUI

local ESPObjects = {}

local function RemoveESP(model)
    local obj = ESPObjects[model]

    if obj then
        obj:Destroy()
        ESPObjects[model] = nil
    end
end

local function IsNPC(model)
    return model:IsA("Model")
        and model:FindFirstChildOfClass("Humanoid")
        and not Players:GetPlayerFromCharacter(model)
end

local function CreateESP(model)
    if ESPObjects[model] or not IsNPC(model) then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")

    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Head")

    if not root then return end

    local folder = Instance.new("Folder")
    folder.Name = model.Name
    folder.Parent = ESPFolder

    local highlight = Instance.new("Highlight")
    highlight.Adornee = model
    highlight.FillTransparency = 1
    highlight.OutlineColor = PURPLE
    highlight.Enabled = false
    highlight.Parent = folder

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(150,65)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = folder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,0,25)
    label.BackgroundTransparency = 1
    label.TextColor3 = WHITE
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Parent = billboard

    local healthBack = Instance.new("Frame")
    healthBack.Position = UDim2.fromOffset(10,29)
    healthBack.Size = UDim2.new(1,-20,0,7)
    healthBack.BackgroundColor3 = Color3.fromRGB(50,40,50)
    healthBack.BorderSizePixel = 0
    healthBack.Parent = billboard

    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.fromScale(1,1)
    healthFill.BackgroundColor3 = Color3.fromRGB(70,255,100)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = healthBack

    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0,0.5)
    line.BorderSizePixel = 0
    line.BackgroundColor3 = PURPLE
    line.Visible = false
    line.Parent = ESPFolder

    ESPObjects[model] = folder

    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not model.Parent or not root.Parent then
            connection:Disconnect()
            line:Destroy()
            RemoveESP(model)
            return
        end

        local myRoot = Character and
            Character:FindFirstChild("HumanoidRootPart")

        if not myRoot then return end

        local distance = (myRoot.Position-root.Position).Magnitude

        local screen, visible =
            Camera:WorldToViewportPoint(root.Position)

        local inRange = distance <= MAX_DISTANCE
            and visible
            and humanoid.Health > 0

        billboard.Enabled = inRange and
            (State.ESPHealth or State.ESPDistance)

        highlight.Enabled = inRange and State.ESPBox

        if inRange then
            local text = model.Name

            if State.ESPHealth then
                text = text .. " | HP " ..
                    math.floor(humanoid.Health) ..
                    "/" .. math.floor(humanoid.MaxHealth)

                healthBack.Visible = true

                healthFill.Size = UDim2.fromScale(
                    math.clamp(
                        humanoid.Health /
                        math.max(humanoid.MaxHealth,1),
                        0,1
                    ),
                    1
                )
            else
                healthBack.Visible = false
            end

            if State.ESPDistance then
                text = text .. " | " ..
                    math.floor(distance) .. "m"
            end

            label.Text = text

            if State.ESPLine then
                local startPos = Vector2.new(
                    Camera.ViewportSize.X/2,
                    0
                )

                local endPos = Vector2.new(
                    screen.X,
                    screen.Y
                )

                local delta = endPos-startPos

                line.Position = UDim2.fromOffset(
                    startPos.X,startPos.Y
                )

                line.Size = UDim2.fromOffset(
                    delta.Magnitude,2
                )

                line.Rotation = math.deg(
                    math.atan2(delta.Y,delta.X)
                )

                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end)

    folder.Destroying:Connect(function()
        if connection then connection:Disconnect() end
        if line then line:Destroy() end
    end)
end

