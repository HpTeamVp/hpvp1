local function destroyEsp(model)
	local e = tracked[model]
	if not e then return end
	e.line:Destroy(); e.box:Destroy(); e.bar:Destroy(); e.text:Destroy()
	tracked[model] = nil
	partCache[model] = nil
end

local function register(hum)
	local m = hum.Parent
	if not m or not m:IsA("Model") or tracked[m] then return end
	if m == lp.Character or Players:GetPlayerFromCharacter(m) then return end
	if hum.Health <= 0 then return end
	makeEsp(m)
end

Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then task.defer(register, d) end
end)

task.spawn(function()
	while true do
		local list, n = {}, 0
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("Humanoid") then
				if d.Parent then table.insert(list, d.Parent) end
				register(d)
			end
		end
		for _ in pairs(tracked) do n += 1 end
		baseExclude = list
		applyExclude()
		statusLabel.Text = "Mob tìm thấy: " .. n
		task.wait(1.5)
	end
end)

local function visibleParts(model)
	local c = partCache[model]
	if c and os.clock() - c.t < 1 then return c.list end
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.9 and not d:FindFirstAncestorOfClass("Tool") then
			local s = d.Size
			if math.max(s.X, s.Y, s.Z) <= 20 then table.insert(list, d) end
		end
	end
	partCache[model] = { t = os.clock(), list = list }
	return list
end

local function worldBounds(parts)
	local mn = Vector3.new(math.huge, math.huge, math.huge)
	local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, part in ipairs(parts) do
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = part.CFrame:GetComponents()
		local s = part.Size / 2
		local ex = math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z
		local ey = math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z
		local ez = math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z
		mn = Vector3.new(math.min(mn.X, x - ex), math.min(mn.Y, y - ey), math.min(mn.Z, z - ez))
		mx = Vector3.new(math.max(mx.X, x + ex), math.max(mx.Y, y + ey), math.max(mx.Z, z + ez))
	end
	return mn, mx
end

local function project(camCF, world, k, vp)
	local v = camCF:PointToObjectSpace(world)
	local behind = v.Z > -0.05
	local dz = behind and 0.05 or -v.Z
	local x = vp.X / 2 + (v.X / dz) * k
	local y = vp.Y / 2 - (v.Y / dz) * k
	return Vector2.new(math.clamp(x, -vp.X * 2, vp.X * 3), math.clamp(y, -vp.Y * 2, vp.Y * 3)), behind
end

local function hideEsp(e)
	e.line.Visible = false
	e.box.Visible = false
	e.bar.Visible = false
	e.text.Visible = false
end

local function updateOne(model, e, cam, vp, camCF, k)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not model:IsDescendantOf(Workspace) or not hum or hum.Health <= 0 then
		destroyEsp(model)
		return
	end

	local parts = visibleParts(model)
	local mn, mx
	if #parts > 0 then
		mn, mx = worldBounds(parts)
	else
		local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		if not root then hideEsp(e) return end
		mn, mx = root.Position - Vector3.new(1.5, 3, 1.5), root.Position + Vector3.new(1.5, 3, 1.5)
	end

	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local behindCount = 0
	for _, x in ipairs({ mn.X, mx.X }) do
		for _, y in ipairs({ mn.Y, mx.Y }) do
			for _, z in ipairs({ mn.Z, mx.Z }) do
				local pt, behind = project(camCF, Vector3.new(x, y, z), k, vp)
				if behind then behindCount += 1 end
				minX, minY = math.min(minX, pt.X), math.min(minY, pt.Y)
				maxX, maxY = math.max(maxX, pt.X), math.max(maxY, pt.Y)
			end
		end
	end

	local show = behindCount < 8
	minX, minY = math.max(minX, -40), math.max(minY, -40)
	maxX, maxY = math.min(maxX, vp.X + 40), math.min(maxY, vp.Y + 40)
	local w, h = maxX - minX, maxY - minY
	if w < 2 or h < 2 then show = false end

	local center = (mn + mx) / 2
	local cs, cBehind = project(camCF, center, k, vp)
	if cBehind then
		local mid = Vector2.new(vp.X / 2, vp.Y / 2)
		local f = mid - (cs - mid)
		cs = Vector2.new(math.clamp(f.X, 0, vp.X), math.clamp(f.Y, 0, vp.Y))
	end

	e.line.Visible = State.Line
	if State.Line then
		local a = Vector2.new(vp.X / 2, 0)
		local d = cs - a
		e.line.Size = UDim2.fromOffset(math.max(d.Magnitude, 1), 1.5)
		e.line.Position = UDim2.fromOffset((a.X + cs.X) / 2, (a.Y + cs.Y) / 2)
		e.line.Rotation = math.deg(math.atan2(d.Y, d.X))
	end

	e.box.Visible = show and State.Box
	if e.box.Visible then
		e.box.Position = UDim2.fromOffset(minX, minY)
		e.box.Size = UDim2.fromOffset(w, h)
	end

	local showHp = show and State.Health
	e.bar.Visible = showHp
	e.text.Visible = showHp
	if showHp then
		local ratio = hum.Health / math.max(hum.MaxHealth, 1)
		if ratio ~= ratio then ratio = 0 end
		ratio = math.clamp(ratio, 0, 1)
		e.bar.Position = UDim2.fromOffset(minX - 7, minY)
		e.bar.Size = UDim2.fromOffset(4, h)
		e.fill.Size = UDim2.fromScale(1, ratio)
		e.fill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(60, 255, 90), ratio)
		e.text.Position = UDim2.fromOffset((minX + maxX) / 2, math.max(minY - 2, 14))
		e.text.Text = string.format("%s  %d/%d", model.Name, math.floor(hum.Health), math.floor(hum.MaxHealth))
	end
end

RunService:BindToRenderStep("HpTeamProEsp", Enum.RenderPriority.Camera.Value + 1, function()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	if vp.X < 10 or vp.Y < 10 then return end
	local camCF = cam.CFrame
	local k = (vp.Y / 2) / math.tan(math.rad(cam.FieldOfView) / 2)

	for model, e in pairs(tracked) do
		local ok = pcall(updateOne, model, e, cam, vp, camCF, k)
		if not ok then hideEsp(e) end
	end
end)

-- Chia sẻ State và hàm dùng chung cho File 2
_G.HpTeamPro = {
	State = State,
	getChar = getChar,
	tracked = tracked,
	SOLID = SOLID,
	Workspace = Workspace,
	lp = lp,
	Players = Players,
	isKilling = function() return killing end,
	setKilling = function(v) killing = v end,
}
local Hub = _G.HpTeamPro
if not Hub then
	warn("Chạy File 1 trước.")
	return
end

local State = Hub.State
local getChar = Hub.getChar
local tracked = Hub.tracked
local SOLID = Hub.SOLID
local Workspace = Hub.Workspace
local lp = Hub.lp
local Players = Hub.Players

local AURA_TIMEOUT = 5

local function getTool(hum)
	local char = lp.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then return tool end
	local bp = lp:FindFirstChildOfClass("Backpack")
	local t = bp and bp:FindFirstChildOfClass("Tool")
	if t then
		hum:EquipTool(t)
		return t
	end
end

local function pickTarget()
	local char, hum, root = getChar()
	if not char or hum.Health <= 0 then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end

	local best, bestHum, bestRoot, bestDist
	for model in pairs(tracked) do
		local mh = model:FindFirstChildOfClass("Humanoid")
		local mr = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		if mh and mr and mh.Health > 0 and model:IsDescendantOf(Workspace) then
			local d = (mr.Position - root.Position).Magnitude
			if d <= State.AuraRange then
				local _, onScreen = cam:WorldToViewportPoint(mr.Position)
				if onScreen and (not bestDist or d < bestDist) then
					best, bestHum, bestRoot, bestDist = model, mh, mr, d
				end
			end
		end
	end
	return best, bestHum, bestRoot
end

task.spawn(function()
	while true do
		task.wait(0.15)
		if not State.KillAura or Hub.isKilling() then continue end

		local model, mh, mr = pickTarget()
		if not model or not mr then continue end
		local char, hum, root = getChar()
		if not char then continue end

		Hub.setKilling(true)
		local home = root.CFrame
		local t0 = os.clock()

		pcall(function()
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
			hum.PlatformStand = true

			while State.KillAura
				and model:IsDescendantOf(Workspace)
				and hum.Health > 0
				and os.clock() - t0 < AURA_TIMEOUT do

				local stillAlive = true
				if mh and mh:IsDescendantOf(Workspace) then
					if mh.Health <= 0 then stillAlive = false end
				end
				if not stillAlive then break end

				if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
				if char:GetAttribute("Dead") then char:SetAttribute("Dead", false) end

				local target = mr.CFrame * CFrame.new(0, 0, 3)
				root.CFrame = CFrame.lookAt(target.Position, Vector3.new(mr.Position.X, target.Position.Y, mr.Position.Z))
				root.AssemblyLinearVelocity = Vector3.zero

				local tool = getTool(hum)
				if tool then tool:Activate() end

				task.wait(State.AuraHitDelay or 0.05)
			end
		end)

		local c2, h2, r2 = getChar()
		if c2 and r2 then
			r2.CFrame = home
			r2.AssemblyLinearVelocity = Vector3.zero
			if h2 then h2.PlatformStand = false end
			if not State.Noclip then
				for _, part in ipairs(c2:GetDescendants()) do
					if part:IsA("BasePart") and SOLID[part.Name] then part.CanCollide = true end
				end
			end
		end

		Hub.setKilling(false)
	end
end)
