-- ===== Nhân vật =====
local function getChar()
	local c = lp.Character
	if not c then return end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	if hum and root then return c, hum, root end
end

local function standOffsetOf(hum, root)
	if hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
	return hum.HipHeight + root.Size.Y / 2
end

UIS.JumpRequest:Connect(function()
	if not State.AirJump then return end
	local _, hum = getChar()
	if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
local baseExclude = {}

local function applyExclude()
	local list = table.clone(baseExclude)
	if lp.Character then table.insert(list, lp.Character) end
	rayParams.FilterDescendantsInstances = list
end

local function findGround(x, z, fromY)
	local r = Workspace:Raycast(Vector3.new(x, fromY, z), Vector3.new(0, -400, 0), rayParams)
	return r and r.Position.Y
end

local SOLID = { Head = true, Torso = true, UpperTorso = true, LowerTorso = true, HumanoidRootPart = true }
local lastChar, wasNoclip = nil, false
local killing = false
local speedConn

local function bindSpeedGuard(hum)
	if speedConn then speedConn:Disconnect() end
	speedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if State.Speed and hum.WalkSpeed ~= State.SpeedValue then
			hum.WalkSpeed = State.SpeedValue
		end
	end)
end

RunService.Stepped:Connect(function()
	local char, hum, root = getChar()
	if not char then return end

	if char ~= lastChar then
		lastChar, wasNoclip = char, false
		applyExclude()
		bindSpeedGuard(hum)
	end

	if State.Speed then
		if hum.WalkSpeed ~= State.SpeedValue then
			hum.WalkSpeed = State.SpeedValue
		end
	else
		if hum.WalkSpeed ~= NORMAL_SPEED then
			hum.WalkSpeed = NORMAL_SPEED
		end
	end

	if State.Noclip and not killing then
		local p = root.Position
		local offset = standOffsetOf(hum, root)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
		local g = findGround(p.X, p.Z, p.Y + 3)
		if g then
			local standY = g + offset
			if p.Y < standY - 1 then
				local v = root.AssemblyLinearVelocity
				root.CFrame = root.CFrame + Vector3.new(0, standY - p.Y, 0)
				root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
			end
		end
	elseif wasNoclip and not State.Noclip then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and SOLID[part.Name] then part.CanCollide = true end
		end
	end

	wasNoclip = State.Noclip

	if State.GodMode then
		if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
		if char:GetAttribute("Dead") then char:SetAttribute("Dead", false) end
	end
end)

